COMPOSE_PROJECT_NAME=kwagent
KW_IMAGE=kwagent:0.1.0
KW_DATA_ROOT=./data
KW_PUBLIC_URL=
KW_HOST_PORT=3080
KW_TIME_ZONE=Asia/Shanghai
KW_CPU_LIMIT=2
KW_MEMORY_LIMIT=4g
LAGRANGE_BASE_URL=https://agent-kw-milky.d1no.cn/
LAGRANGE_ACCESS_TOKEN=
LAGRANGE_TOOL_TIMEOUT_MS=60000
LAGRANGE_RECONCILE_INTERVAL_SECONDS=300
KW_LLM_PROVIDER=deepseek-official
KW_LLM_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
KW_EMBEDDING_BASE_URL=
KW_EMBEDDING_MODEL=
KW_EMBEDDING_API_KEY=
KW_VISION_BASE_URL=
KW_VISION_MODEL=
KW_VISION_API_KEY=
KW_EVENT_BATCH_WINDOW_MS=1000
KW_CONTEXT_MEMORY_TOKENS=8192
